.venv/
__pycache__/
*.pyc

# API keys and tokens. Kaggle credentials normally live in ~/.kaggle/, but
# ignore them here too in case a copy ever lands in the repo.
.env
kaggle.json
access_token

# Generated by the pipeline; companies.csv and skills.csv stay tracked.
data/*.db
data/raw/*
!data/raw/.gitkeep
# Curated input, not pipeline output: the loader's name matching is only
# reproducible if this is committed alongside companies.csv.
!data/raw/company_aliases.csv

.pytest_cache/
.streamlit/secrets.toml
