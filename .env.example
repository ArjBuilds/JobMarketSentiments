# Copy to .env and fill in. .env is gitignored; this template is committed.
#
# GNews is the only API in the project. Every other source is a CSV in
# data/raw/, so this is the only key you need.

# News coverage (F6) — https://gnews.io
GNEWS_API_KEY=

# Optional: point the app at a different database, e.g. a frozen demo copy.
# JMSA_DB_PATH=

# --- Backend (backend/, docs/BACKEND.md). Everything below is optional. ---
# sqlite (default, no Docker) or clickhouse (after `docker compose up -d`).
# BACKEND_STORE=sqlite
# BACKEND_SQLITE_PATH=
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DB=jmsa
