# Copy to .env and fill in. .env is gitignored; this template is committed.
#
# Google News RSS, the Greenhouse public boards and the Lever public boards
# need no key, so only these three are required.

# Open roles in India — https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# News coverage — https://gnews.io (swap for NEWSAPI_KEY if using NewsAPI)
GNEWS_API_KEY=

# Optional: point the app at a different database, e.g. a frozen demo copy.
# JMSA_DB_PATH=
